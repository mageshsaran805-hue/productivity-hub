# ─────────────────────────────────────────────────────────────────────
# Productivity Hub — environment variables
# Copy to .env.local for local dev, or set these in your host's env
# (e.g. Vercel Project Settings → Environment Variables).
# NEVER commit real values — the real .env* files are gitignored.
# ─────────────────────────────────────────────────────────────────────

# Postgres connection string (Supabase free-tier works great; use the
# transaction pooler / port 6543 for serverless hosts like Vercel).
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-random-32-byte-base64-string

# Public origin of this deployment (NOT localhost in production)
BETTER_AUTH_URL=https://your-app.vercel.app

# Resend API key for password-reset emails (optional — signup works without it)
RESEND_API_KEY=